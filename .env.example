# AutoUE local secrets and runtime switches.
# Machine-specific filesystem paths live in config/local.json, not here.
LANGCHAIN_TRACING_V2=false
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=autoue-local

AUTOUE_CONFIG=
AUTOUE_WORKFLOW=
AUTOUE_TS_OUTPUT_DIR=

# Preferred local/OpenAI-compatible LLM service.
OPENAI_API_KEY=
OPENAI_BASE_URL=http://127.0.0.1:8000/v1
OPENAI_MODEL=local-model

# Optional legacy providers / external services.
DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=
TAVILY_API_KEY=
SKETCHFAB_TOKEN=
GITLAB_API=https://gitlab.com/api/v4
PROJECT_PATH=denispahunov/mapmagic
TOKEN=GITLAB_TOKEN

# Codex CLI provider. Leave model vars empty to use the current Codex config default.
CODEX_CLI_PATH=
CODEX_FAST_MODEL=gpt-5.5
CODEX_PLANNING_MODEL=gpt-5.5
CODEX_CODEGEN_MODEL=gpt-5.5
CODEX_AGENT_TIMEOUT_SEC=1200
