      "factory": "custom_nodes.key_element_extractor:create_key_element_extractor",
      "prompt_file": "prompts/key_element_extractor.md",
      "enabled": true,
      "llm_profile": "openai_compatible"
    },
    {
      "name": "RetrieveModel",
      "factory": "custom_nodes.retrieve_model:create_retrieve_model_node",
      "prompt_file": "prompts/retrieve_model.md",
      "enabled": true,
      "llm_profile": "openai_compatible"
    },
    {
      "name": "ModuleAnalyzer",
      "factory": "custom_nodes.module_analyzer:create_module_analyzer",
