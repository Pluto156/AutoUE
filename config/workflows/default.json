{
  "schema_version": 1,
  "name": "autoue_default_cpp_research_flow",
  "description": "Original AutoUE node order, but node calls and prompts are configured outside Python code.",
  "nodes": [
    {
      "name": "SceneAndGameplaySplitter",
      "factory": "custom_nodes.scene_and_gameplay_splitter:create_scene_and_gameplay_splitter",
      "prompt_file": "prompts/scene_and_gameplay_splitter.md",
      "enabled": true,
      "llm_profile": "openai_compatible"
    },
    {
      "name": "SceneFormalizer",
      "factory": "custom_nodes.scene_formalizer:create_scene_formalizer",
      "prompt_file": "prompts/scene_formalizer.md",
      "enabled": true,
      "llm_profile": "openai_compatible"
    },
    {
