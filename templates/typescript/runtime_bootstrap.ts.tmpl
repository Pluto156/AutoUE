export interface {{interface_name}} {
  state?: Record<string, unknown>;
  events?: string[];
}

const ENTITY_ID = {{entity_id_json}};
const BEHAVIOR_ID = {{behavior_id_json}};
const FLOW_ID = {{flow_id_json}};
const RUNTIME_MAPPING_PATH = {{runtime_mapping_path_json}};
const RESULT_LABEL = {{result_label_json}};

export function {{export_name}}(context: {{interface_name}} = {}): Record<string, unknown> {
  const state = context.state || {};
  const events = context.events || [];
  state[ENTITY_ID + ':ready'] = true;
  state[BEHAVIOR_ID + ':result'] = RESULT_LABEL;
  state[BEHAVIOR_ID + ':flow'] = FLOW_ID;
  state[BEHAVIOR_ID + ':runtimeMapping'] = RUNTIME_MAPPING_PATH;
  events.push('runtime ready for ' + BEHAVIOR_ID);
  return { state, events };
}
