export interface {{interface_name}} {
  actorName?: string;
  targetName?: string;
  state?: Record<string, unknown>;
  events?: string[];
}

const ENTITY_ID = {{entity_id_json}};
const BEHAVIOR_ID = {{behavior_id_json}};
const FLOW_ID = {{flow_id_json}};
const RUNTIME_MAPPING_PATH = {{runtime_mapping_path_json}};
const ACTION_LABEL = {{action_label_json}};
const TARGET_LABEL = {{target_label_json}};
const RESULT_LABEL = {{result_label_json}};

export function {{export_name}}(context: {{interface_name}} = {}): string {
  const actorName = context.actorName || 'Actor';
  const targetName = context.targetName || TARGET_LABEL;
  const message = actorName + ' ' + ACTION_LABEL + ' ' + targetName + ': ' + RESULT_LABEL;
  if (context.events) {
    context.events.push(message);
  }
  if (context.state) {
    context.state[BEHAVIOR_ID] = { entityId: ENTITY_ID, flowId: FLOW_ID, runtimeMappingPath: RUNTIME_MAPPING_PATH, result: RESULT_LABEL };
  }
  return message;
}
